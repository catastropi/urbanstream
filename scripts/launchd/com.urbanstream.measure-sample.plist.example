<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  STEP 2 5분 표본 수집기 (scripts/measure_sample.py) 의 launchd 예시. 기본 방법이 아니다.
  11-25 이 프로젝트의 Mac 에서는 주기 실행이 되지 않았다('domain in on-demand-only mode', 원인 미확정, DEFERRED D-290).
  기본은 `python scripts/measure_sample.py --start` (docs/runbooks/measure.md 2절). 이 파일은 다른 Mac 에서 launchd 로 돌리고 싶을 때만 쓴다.
  복사한 뒤 아래 두 경로만 자기 것으로 바꾼다.
    __REPO__    프로젝트 폴더 절대 경로   (예: /Users/<이름>/urbanstream)
    __PYTHON__  conda urbanstream 환경의 python 절대 경로  (터미널에서 `conda activate urbanstream && which python`)
  설치:  cp scripts/launchd/com.urbanstream.measure-sample.plist.example ~/Library/LaunchAgents/com.urbanstream.measure-sample.plist
         (경로 바꾸기) → launchctl load ~/Library/LaunchAgents/com.urbanstream.measure-sample.plist
  끄기:  launchctl unload ~/Library/LaunchAgents/com.urbanstream.measure-sample.plist
  Mac 이 자는 동안은 돌지 않는다. 깨어나면 다음 주기부터 다시 돈다(빈 구간은 기록의 시각 간격으로 보인다).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.urbanstream.measure-sample</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__REPO__/scripts/measure_sample.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <!-- launchd 는 로그인 셸의 PATH 를 쓰지 않는다. docker 명령을 찾을 수 있게 넣는다 (Docker Desktop 은 /usr/local/bin 에 링크를 만든다) -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>Nice</key>
  <integer>10</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__REPO__/data/measure/samples/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/measure/samples/launchd.err.log</string>
</dict>
</plist>

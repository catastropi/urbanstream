# UrbanStream Step 0 - API 인증키 설정
# 이 파일을 복사해서 ".env" 파일을 만들고 실제 값을 채우세요.
#   Mac/zsh:  cp .env.example .env
# .env 파일은 git에 절대 올리지 마세요 (.gitignore 에 이미 등록되어 있습니다).

# 서울 열린데이터광장(data.seoul.go.kr) 인증키 — data.go.kr 과 완전히 별도인 시스템이라
# 아직 발급받지 않았다면 반드시 따로 신청해야 합니다.
# -> 서울시 실시간 도로 소통 정보(TrafficInfo), 실시간 돌발 정보(AccInfo) 에 사용 (문제 A, B의 핵심 데이터)
SEOUL_API_KEY=

# 공공데이터포털(data.go.kr) 인증키 — 계정당 1개, 승인받은 모든 서비스에 공통으로 사용됨
# (Decoding 형태 그대로 붙여넣으면 됨. Encoding 키를 넣어도 스크립트가 자동 변환함)
# -> 서울특별시 버스위치/도착정보조회서비스, TAGO 버스노선/정류소정보(Phase2), 기상청 초단기실황 조회 에 사용
DATA_GO_KR_KEY=

# ---- 서울 버스(메인 소스) — 'python scripts/smoke_test.py seoul-bus-ids' 로 조회해서 채우세요 ----
# (2026-10-13: TAGO는 서울을 다루지 않는다는 게 실제 테스트로 확인되어, 서울 버스는 다시
#  data.go.kr에 승인받아둔 "서울특별시_버스위치/도착정보조회서비스"를 메인으로 사용함)
# seoul-bus-ids 1단계(노선 검색)에 쓸 버스 번호
SEOUL_BUS_ROUTE_NO=143
# seoul-bus-ids 2단계(정류소 검색)에 쓸 정류소 이름 검색어
SEOUL_BUS_STOP_NAME=강남역
# seoul-bus-ids 1단계 결과에서 고른 busRouteId
SEOUL_BUS_ROUTE_ID=
# seoul-bus-ids 2단계 결과에서 고른 stId
SEOUL_BUS_STOP_ID=

# ---- TAGO(국토교통부) 버스 ID — Phase 2(서울 외 지역) 예비용. 지금은 안 써도 됨 ----
# 'python scripts/smoke_test.py tago-ids' 로 조회해서 채우세요 (서울은 TAGO에 없으니 다른 도시로)
TAGO_CITY_CODE=
TAGO_ROUTE_NO=143
TAGO_NODE_NAME=강남역
TAGO_ROUTE_ID=
TAGO_NODE_ID=

# 테스트에 사용할 서울 도로 링크ID (TrafficInfo 조회 파라미터). 비워두면 스크립트 기본 샘플 링크ID로 시도
SEOUL_TRAFFIC_LINK_ID=

# 기상청 초단기실황 조회용 격자 좌표 (기본값 60,127 = 서울시청 부근, 활용가이드의 좌표변환 엑셀로 재확인 권장)
KMA_NX=60
KMA_NY=127


# ---- Step 2: Docker Compose 인프라 (postgres / kafka / kafka-ui) ----
# `scripts/stack.sh init-env` 가 .env 에 없는 항목만 아래 값으로 채운다. 비어 있는 비밀 값은 자동 생성된다.
# stack:begin
# 어떤 profile 을 기본으로 켤지: core = postgres+kafka, dev = kafka-ui
COMPOSE_PROFILES=core
POSTGRES_USER=urbanstream
POSTGRES_DB=urbanstream
# 비워 두면 init-env 가 무작위 값을 만든다 (로컬 전용)
POSTGRES_PASSWORD=
# 5432 는 다른 Postgres(예: 첫 프로젝트)와 겹치기 쉬워서 5433 을 쓴다
POSTGRES_PORT=5433
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8090
# 비워 두면 init-env 가 KRaft 클러스터 ID(22자)를 만든다. 데이터 볼륨을 만든 뒤에는 바꾸지 않는다
KAFKA_CLUSTER_ID=
# Airflow (Step 7) — 아래 비밀 값은 모두 init-env 가 무작위로 만든다 (로컬 전용). 켜는 법: scripts/stack.sh up-airflow
AIRFLOW_UI_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_DB_PASSWORD=
GOLD_LOADER_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
# API (Step 9) — 켜는 법: scripts/stack.sh up-api. API_DB_PASSWORD(api_service 로그인)·API_KEYS(요청 헤더 X-API-Key, 쉼표로 여러 개, 각 24자 이상)는 init-env 가 무작위로 만든다.
API_PORT=8010
API_DB_PASSWORD=
API_KEYS=
# 대시보드 (Step 10) — 켜는 법: scripts/stack.sh up-dashboard. DASHBOARD_API_KEY 는 대시보드 전용 키(init-env 가 만들고 API_KEYS 목록 끝에 추가한다).
# 선택(기본값 있음, 필요할 때만 주석 해제): DASHBOARD_TTL_SCALE=1.0 (캐시 시간 배율) / DASHBOARD_MEM_LIMIT=512m / DASHBOARD_IMAGE_TAG=1.0.0
DASHBOARD_PORT=8501
DASHBOARD_API_KEY=
# stack:end

# ---- Step 4: Spark / Bronze (선택 — 모두 기본값이 있어 비워 둬도 된다. init-env 가 건드리지 않는 영역) ----
# SPARK_IMAGE=apache/spark:4.1.3-scala2.13-java17-python3-ubuntu   # 베이스 이미지 (태그 고정, latest 금지)
# SPARK_VERSION=4.1.3                                              # 커넥터 jar 버전 = Spark 버전
# SPARK_BRONZE_MEM_LIMIT=1536m                                     # 컨테이너 메모리 한도 (드라이버 힙 1g + 여유)
# SPARK_UI_PORT=4040                                               # Spark UI (127.0.0.1 에만 열림)
# BRONZE_TRIGGER_SEC=60                                            # 쓰기 주기. 작은 파일이 많으면 300 으로 (ADR-0005)
# BRONZE_MAX_OFFSETS_PER_TRIGGER=50000                             # 한 번에 읽을 최대 메시지 수 (밀린 양을 나눠 읽기). 0 이면 제한 없음
# BRONZE_STARTING_OFFSETS=earliest                                 # 새 쿼리가 처음 시작할 때만 적용

# ---- Step 6: Gold (선택 — 기본값이 있다) ----
# SPARK_GOLD_MEM_LIMIT=1536m           # spark-gold 컨테이너 메모리 한도
# POSTGRES_HOST=127.0.0.1              # 호스트에서 마이그레이션·적재를 돌릴 때의 접속 주소 (포트는 위의 POSTGRES_PORT)
# GOLD_WRITER_USER=gold_writer         # 설정하면 적재가 최소 권한 역할로 접속한다. 로그인 역할을 만들고 비밀번호를 지정한 뒤에만 켠다 (docs/runbooks/step6-gold.md)
# GOLD_WRITER_PASSWORD=

# ---- Step 8: 알림 (선택 — stack:begin/end 밖이라 init-env 가 건드리지 않는다. 웹훅 URL 은 비밀이다: 여기(.env)에만 쓰고 채팅·코드·문서에 붙이지 않는다) ----
# ALERT_WEBHOOK_URL=                   # Discord 웹훅 URL 또는 Slack Incoming Webhook URL. 비워 두면 알림은 DB(ops.alert_event)에만 쌓인다
# ALERT_WEBHOOK_KIND=discord           # discord | slack
# ALERTS_ENABLED=true                  # false 면 웹훅 전송을 끈다(기록은 계속)
# MONITOR_MEM_LIMIT=256m               # monitor 컨테이너 메모리 한도. 실측 후 조정 (docs/DEFERRED.md D-126)

# ---- Step 9: API (선택 — stack:begin/end 밖이라 init-env 가 건드리지 않는다. 모두 기본값이 있다) ----
# API_MEM_LIMIT=256m                   # api 컨테이너 메모리 한도. 샌드박스 측정: 동시 20개 부하 후 RSS 약 82 MiB → 약 3배 여유. Mac 에서 docker stats 로 확인 후 조정
# API_RATE_LIMIT_PER_MIN=120           # 키별 분당 요청 상한 (버스트는 API_RATE_BURST=40)
# API_CORS_ORIGINS=                    # 쉼표로 구분한 허용 출처. 비우면 CORS 꺼짐. '*' 는 거부된다
# API_DOCS_ENABLED=true                # false 면 /docs, /openapi.json 을 끈다
# API_STALE_AFTER_SEC=10800            # meta.stale 기준(마지막 데이터가 이보다 오래되면 true)

# ---- STEP 2: 성능 측정 (선택 — stack:begin/end 밖이라 init-env 가 건드리지 않는다. 모두 기본값이 있다. docs/runbooks/measure.md) ----
# 측정 기준(금지 시간대, 안전 기준, 반복 횟수)은 config/measure.yaml 에 있다. 여기에는 컨테이너 한도만 둔다.
# MEASURE_MEM_LIMIT=1g                 # measure 컨테이너(합성 Gold 적재) 메모리 한도. 이 한도에 걸려 죽는 것은 측정뿐이다
# MEASURE_CPUS=1                       # measure 컨테이너 CPU 상한
# MEASURE_NICE=10                      # measure 컨테이너와 gold-runner 측정 요청의 nice 값
# MEASURE_RUNNER_TIMEOUT_SEC=1200      # gold-runner 측정 요청 하나의 시간 한도 (config/measure.yaml runner.measure_timeout_sec 와 같게)

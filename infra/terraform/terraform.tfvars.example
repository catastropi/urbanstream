# 이 파일을 terraform.tfvars 로 복사해 채운다. terraform.tfvars 는 git 에서 제외된다(.gitignore) — 채팅·git 에 붙이지 않는다.
# 내 공인 IP 가 바뀌면 이 값만 고쳐 `terraform apply` 한다.
allowed_ssh_cidr = "203.0.113.7/32"

# 기본값을 바꿀 때만 주석을 푼다.
# ssh_public_key_path = "~/.ssh/urbanstream_azure.pub"
# vm_size             = "Standard_B2s_v2"
